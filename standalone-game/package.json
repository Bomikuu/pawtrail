{
  "name": "pawtrail-neighborhood",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "assets:prepare": "node scripts/prepare-world.mjs",
    "test:game": "node --import tsx --test tests/game-systems.test.ts",
    "typecheck": "tsc --noEmit",
    "sync:app": "node scripts/sync-game-to-app.mjs",
    "dev:homes": "node scripts/start-homes.mjs",
    "assets:housing:runtime": "python3 scripts/prepare-housing-runtime.py",
    "maps:prepare": "node scripts/prepare-map-runtime.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "6.16.0",
    "phaser": "4.2.1",
    "radix-ui": "^1.8.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.3.0",
    "three": "0.187.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
