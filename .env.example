NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, restricted browser Maps identifiers
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server-only configuration: provide local values without committing secrets
DJANGO_API_BASE_URL=
SESSION_SECRET=

# Optional writable directory for isolated local demo data
DEMO_DATA_DIR=

# Explicit opt-in: reset only the requesting demo session
DEMO_ALLOW_RESET=false
