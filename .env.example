NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, restricted browser Maps identifiers
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google OAuth web client ID (public identifier, not a secret).
# Real sign-in also needs the Django POST /auth/google endpoint.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only configuration: provide local values without committing secrets
# Includes the upstream API prefix, e.g. http://127.0.0.1:8000/api/v1
DJANGO_API_BASE_URL=
# Real authentication requires at least 32 random characters; server-only
SESSION_SECRET=

# Optional writable directory for isolated local demo data
DEMO_DATA_DIR=

# Explicit opt-in: reset only the requesting demo session
DEMO_ALLOW_RESET=false
