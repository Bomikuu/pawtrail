NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, restricted browser Maps identifiers
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Google OAuth web client ID (public identifier, not a secret).
# Real sign-in also needs the Django POST /auth/google endpoint.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only configuration: provide local values without committing secrets
# Includes the upstream API prefix, e.g. http://127.0.0.1:8000/api/v1
DJANGO_API_BASE_URL=http://127.0.0.1:8002/api/v1
# Django local community browsing includes persisted fixtures by default.
# Set this on the Django process to 0 to hide them; production always hides them.
PAWTRAIL_COMMUNITY_FIXTURES=1
# Django read budgets are separate from mutation/capture limits.
PAWTRAIL_ANON_READ_RATE=600/min
PAWTRAIL_USER_READ_RATE=1200/min
# Real authentication requires at least 32 random characters; server-only
SESSION_SECRET=

# Optional writable directory for isolated local demo data
DEMO_DATA_DIR=

# Explicit opt-in: reset only the requesting demo session
DEMO_ALLOW_RESET=false

# Real camera/identity service; can run while the community remains in mock mode.
PAWTRAIL_CAPTURE_API_BASE_URL=http://127.0.0.1:8002/api/v1
# At least 32 random characters in production. Local development creates an ignored secret.
CAPTURE_SESSION_SECRET=

# Embedded Pixelcore Studio landing API. Local isolated service uses port 8003.
# In production omit this to use DJANGO_API_BASE_URL, or set a trusted API origin.
PAWTRAIL_LANDING_API_BASE_URL=http://127.0.0.1:8003/api/v1
