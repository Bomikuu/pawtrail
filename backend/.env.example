PAWTRAIL_PLATFORM_HOSTS=127.0.0.1,localhost
# Production requires these and installed PostGIS/vector database extensions.
# PAWTRAIL_PRODUCTION=1
# PAWTRAIL_PLATFORM_SECRET=
# DATABASE_URL=postgresql://user:password@localhost:5432/pawtrail
# REDIS_URL=redis://localhost:6379/2
PAWTRAIL_ANALYSIS_QUEUE=database
# Set celery for Redis-backed workers in production.
# PAWTRAIL_EXTERNAL_VISION_ENABLED=true
# PAWTRAIL_VISION_ENDPOINT=https://your-provider.example/v1/chat/completions
# PAWTRAIL_VISION_KEY=
# PAWTRAIL_VISION_MODEL=
